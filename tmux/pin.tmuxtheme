# tmuxtheme by pinpong.co
TMUX_SEPARATOR_L_BOLD=""
TMUX_SEPARATOR_L_THIN=""
TMUX_SEPARATOR_R_BOLD=""
TMUX_SEPARATOR_R_THIN=""

set -g status-justify "left"
set -g status "on"
set -g status-left-style "none"
set -g message-command-style "fg=#9e9e9e,bg=#303030,fill=#303030"
set -g status-right-style "none"
set -g status-style "none,bg=default"
# fill= is what clears the rest of the prompt line; without it the old
# status-line content stays visible behind the rename prompt
set -g message-style "fg=#9e9e9e,bg=#303030,fill=#303030"
set -g pane-border-style "fg=#3a3a3a"
set -g pane-active-border-style "fg=#80a0ff"
set -g status-right-length "100"
set -g status-left-length "100"
setw -g window-status-activity-style "none,fg=#990000,none"
setw -g window-status-separator ""
setw -g window-status-style "none,none,none"

P_C="#{?client_prefix,color4,color8}"
S_C="#{?client_prefix,color8,color4}"
set -g status-left "#[fg=${S_C},bg=${P_C},bold,nounderscore,italics] #S #[fg=${P_C},bg=default,nounderscore,noitalics]${TMUX_SEPARATOR_R_BOLD}"

C_BG_LIST="default"
C_BG_LIST_A="default"

# Claude agent state, published per window by ~/.claude/hooks/tmux-claude-state.sh.
# Renders one coloured dot, or nothing at all when no state is set.
C_MARK="#{?#{==:#{@claude_state},perm},#[fg=red]● ,}#{?#{==:#{@claude_state},idle},#[fg=yellow]● ,}#{?#{==:#{@claude_state},done},#[fg=green]● ,}"

setw -g window-status-format "#[fg=default,bg=${C_BG_LIST}] ${C_MARK}#[fg=default]#I:#W#F "
setw -g window-status-current-format "#[fg=blue,bg=${C_BG_LIST_A},bold] ${C_MARK}#[fg=blue,bold]#I:#W#F "

# One dot per flagged window across every session on this server — pure format,
# so it costs no subprocess and needs no status-interval tuning.
T_AGENTS="#{S:#{W:${C_MARK}}}"
T_TIME="#[fg=default,bg=default]%H:%M #[fg=#default,bg=#303030,nobold,nounderscore,noitalics]#[fg=default,bg=default] %d-%b-%y "

set -g status-right "${T_AGENTS}#[fg=blue,bg=default]${TMUX_SEPARATOR_L_THIN} ${T_TIME}"
